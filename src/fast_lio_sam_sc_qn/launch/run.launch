<launch>

	<arg name="rviz" default="true" />
	<arg name="lidar" default="nclt" /> <!-- ouster, velodyne, livox, kitti, ... -->
	<arg name="sam_downsample" default="false" />
	<arg name="downsample_voxel_size" default="0.4" />
	<!-- <arg name="odom_topic" default="/Odometry" />
	<arg name="lidar_topic" default="/cloud_registered" /> -->
	
	<!-- visualize -->
	<!-- <node if="$(arg rviz)" pkg="rviz" type="rviz" name="rviz_lio" args="-d $(find fast_lio_sam_sc_qn)/config/lio_rviz.rviz" launch-prefix="nice"/> -->
	<node if="$(arg rviz)" pkg="rviz" type="rviz" name="rviz_sam" args="-d $(find fast_lio_sam_sc_qn)/config/sam_rviz.rviz" launch-prefix="nice"/>
	
	<!-- run fast_lio_sam_sc_qn -->
	<rosparam command="load" file="$(find fast_lio_sam_sc_qn)/config/config.yaml" />
	<param name="/basic/odom" value="/Odometry" />
	<param name="/basic/cloud" value="/cloud_registered" />
	<param name="/LighterBEV/downsample_enable" value="$(arg sam_downsample)" />
	<param name="/LighterBEV/downsample_voxel_size" value="$(arg downsample_voxel_size)" />
	<param name="/publish/registered_cloud_ds_en" value="$(eval str(arg('sam_downsample')).lower() == 'false')" />
	<param name="/publish/registered_cloud_ds_as_main_topic" value="$(eval str(arg('sam_downsample')).lower() == 'false')" />
	<param name="/publish/registered_cloud_ds_voxel_size" value="$(arg downsample_voxel_size)" />
	<node pkg="fast_lio_sam_sc_qn" type="fast_lio_sam_sc_qn_node" name="fast_lio_sam_sc_qn_node" output="screen">
		<!-- <remap from="/Odometry" to="$(arg odom_topic)"/>
		<remap from="/cloud_registered" to="$(arg lidar_topic)"/> -->
	</node>
	
	<!-- run fast_lio -->

	<include if="$(eval arg ('lidar') == 'boreas')" file="$(find fast_lio)/launch/mapping_boreas.launch">
		<arg name="rviz" value="false"/>
		<arg name="registered_cloud_ds_en" value="$(eval str(arg('sam_downsample')).lower() == 'false')"/>
		<arg name="registered_cloud_ds_as_main_topic" value="$(eval str(arg('sam_downsample')).lower() == 'false')"/>
		<arg name="registered_cloud_ds_voxel_size" value="$(arg downsample_voxel_size)"/>
	</include>
	<include if="$(eval arg ('lidar') == 'ouster')" file="$(find fast_lio)/launch/mapping_ouster64.launch">
		<arg name="rviz" value="false"/>
	</include>
	<include if="$(eval arg ('lidar') == 'xiyuan')" file="$(find fast_lio)/launch/mapping_ouster128_xiyuan.launch">
		<arg name="rviz" value="false"/>
	</include>
	<include if="$(eval arg ('lidar') == 'sim')" file="$(find fast_lio)/launch/mapping_ouster128_sim.launch">
		<arg name="rviz" value="false"/>
	</include>
	<include if="$(eval arg ('lidar') == 'mars')" file="$(find fast_lio)/launch/mapping_mars.launch">
		<arg name="rviz" value="false"/>
	</include>
	<include if="$(eval arg ('lidar') == 'BG')" file="$(find fast_lio)/launch/mapping_BG.launch">
		<arg name="rviz" value="false"/>
	</include>
	<include if="$(eval arg ('lidar') == 'ouster128')" file="$(find fast_lio)/launch/mapping_ouster128.launch">
		<arg name="rviz" value="false"/>
	</include>
	<include if="$(eval arg ('lidar') == 'velodyne64')" file="$(find fast_lio)/launch/mapping_velodyne64.launch">
		<arg name="rviz" value="false"/>
	</include>
	<include if="$(eval arg ('lidar') == 'nclt')" file="$(find fast_lio)/launch/mapping_velodyne.launch">
		<arg name="rviz" value="false"/>
	</include>
	<include if="$(eval arg ('lidar') == 'livox')" file="$(find fast_lio)/launch/mapping_avia.launch">
		<arg name="rviz" value="false"/>
	</include>
	<include if="$(eval arg ('lidar') == 'kitti')" file="$(find fast_lio)/../fastlio_config_launch/kitti.launch">
		<arg name="rviz" value="false"/>
	</include>
	<include if="$(eval arg ('lidar') == 'mulran')" file="$(find fast_lio)/../fastlio_config_launch/mulran.launch">
		<arg name="rviz" value="false"/>
	</include>
	<include if="$(eval arg ('lidar') == 'newer-college2020')" file="$(find fast_lio)/../fastlio_config_launch/newer-college2020.launch">
		<arg name="rviz" value="false"/>
	</include>
	<include if="$(eval arg ('lidar') == 'kimera-multi-acl_jackal2')" file="$(find fast_lio)/../fastlio_config_launch/kimera-multi-acl_jackal2.launch">
		<arg name="rviz" value="false"/>
	</include>
	<include if="$(eval arg ('lidar') == 'kimera-multi-apis')" file="$(find fast_lio)/../fastlio_config_launch/kimera-multi-apis.launch">
		<arg name="rviz" value="false"/>
	</include>
	<include if="$(eval arg ('lidar') == 'vbr-colosseo')" file="$(find fast_lio)/../fastlio_config_launch/vbr-colosseo.launch">
		<arg name="rviz" value="false"/>
	</include>

</launch>
